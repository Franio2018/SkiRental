@page "/manage-customers"
@using SkiRental.Domain.Models
@using SkiRental.Domain.Enums
@using SkiRental.Logic.Interfaces
@using SkiRental.Logic.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing


@inject IUserRepository UserRepository
@inject IRentalRepository RentalRepository
@inject NavigationManager Navigation
@inject UserService UserService
@inject INotificationService NotificationService

<PageTitle>Manage Customers - SkiRental</PageTitle>

<div class="manage-customers-page">
    <div class="page-header">
        <h1>Manage Customers</h1>
        <p class="subtitle">View and manage all customer profiles and rental history</p>
    </div>

    <div class="filters-section">
        <div class="filter-controls">
            <div class="filter-group">
                <label for="search-query">Search Customers:</label>
                <input type="text" 
                       id="search-query"
                       @bind="SearchQuery" 
                       placeholder="Name, email, or phone..."
                       class="search-input" />
            </div>

            <div class="filter-group">
                <label for="status-filter">Account Status:</label>
                <select id="status-filter" @bind="AccountStatusFilter" class="filter-select">
                    <option value="">All Customers</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <button class="btn-secondary" @onclick="RefreshData">
                🔄 Refresh
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading customers...</p>
        </div>
    }
    else if (_filteredCustomers.Any())
    {
        <div class="customers-table-container">
            <table class="customers-table">
                <thead>
                    <tr>
                        <th @onclick="SortById">ID @GetSortIcon("Id")</th>
                        <th @onclick="SortByName">Name @GetSortIcon("Name")</th>
                        <th @onclick="SortByEmail">Email @GetSortIcon("Email")</th>
                        <th @onclick="SortByPhone">Phone @GetSortIcon("Phone")</th>
                        <th @onclick="SortByTotalRentals">Rentals @GetSortIcon("TotalRentals")</th>
                        <th @onclick="SortByTotalSpent">Total Spent @GetSortIcon("TotalSpent")</th>
                        <th @onclick="SortByLastRental">Last Rental @GetSortIcon("LastRental")</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in _filteredCustomers)
                    {
                        <tr class="customer-row" @onclick="() => SelectCustomer(customer)">
                            <td>@customer.Id</td>
                            <td>
                                <div class="customer-name">
                                    @if (!string.IsNullOrEmpty(customer.FirstName) && !string.IsNullOrEmpty(customer.LastName))
                                    {
                                        <span>@customer.FirstName @customer.LastName</span>
                                    }
                                    else
                                    {
                                        <span class="no-name">No name set</span>
                                    }
                                </div>
                            </td>
                            <td>@customer.Email</td>
                            <td>@customer.PhoneNumber</td>
                            <td>@customer.TotalRentals</td>
                            <td>@customer.TotalSpent PLN</td>
                            <td>
                                @(customer.LastRentalDate == DateTime.MinValue ? "Never" : customer.LastRentalDate.ToString("dd.MM.yyyy"))
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-sm btn-primary" @onclick="() => SelectCustomer(customer)">
                                        View
                                    </button>
                                    <button class="btn-sm btn-secondary" @onclick="() => EditCustomer(customer)">
                                        Edit
                                    </button>
                                    @if (customer.IsActive)
                                    {
                                        <button class="btn-sm btn-warning" @onclick="() => DeactivateCustomer(customer)">
                                            Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn-sm btn-success" @onclick="() => ActivateCustomer(customer)">
                                            Activate
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="no-results">
            <div class="no-results-icon">👥</div>
            <h3>No customers found</h3>
            <p>Try adjusting your search or filter criteria.</p>
        </div>
    }
</div>

<!-- Confirmation Modal -->
@if (_showConfirmationModal)
{
    <div class="modal-overlay" @onclick="CloseConfirmationModal">
        <div class="modal-content confirmation" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>@_confirmationTitle</h2>
                <button class="close-btn" @onclick="CloseConfirmationModal">×</button>
            </div>
            <div class="modal-body">
                <p>@_confirmationMessage</p>
            </div>
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseConfirmationModal">Cancel</button>
                <button class="btn-primary" @onclick="ConfirmAction">Confirm</button>
            </div>
        </div>
    </div>
}

<!-- Customer Details Modal -->
@if (_selectedCustomer != null)
{
    <div class="modal-overlay" @onclick="CloseDetailsModal">
        <div class="modal-content customer-details" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>Customer Details</h2>
                <button class="close-btn" @onclick="CloseDetailsModal">×</button>
            </div>

            <div class="details-tabs">
                <button class="tab-btn @(_activeTab == "profile" ? "active" : "")"
                        @onclick="ShowProfileTab">
                    Profile
                </button>
                <button class="tab-btn @(_activeTab == "measurements" ? "active" : "")"
                        @onclick="ShowMeasurementsTab">
                    Measurements
                </button>
                <button class="tab-btn @(_activeTab == "rentals" ? "active" : "")"
                        @onclick="ShowRentalsTab">
                    Rental History
                </button>
            </div>

            @if (_activeTab == "profile")
            {
                <div class="tab-content">
                    <div class="profile-section">
                        <h3>Personal Information</h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>First Name:</label>
                                <input type="text" @bind="_editingCustomer.FirstName" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label>Last Name:</label>
                                <input type="text" @bind="_editingCustomer.LastName" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label>Email:</label>
                                <input type="email" @bind="_editingCustomer.Email" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label>Phone:</label>
                                <input type="tel" @bind="_editingCustomer.PhoneNumber" class="form-input" />
                            </div>
                        </div>

                        <div class="preferences-section">
                            <h3>Notification Preferences</h3>
                            <div class="checkbox-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" @bind="_editingCustomer.EmailNotificationsEnabled" />
                                    Email notifications
                                </label>
                                <label class="checkbox-label">
                                    <input type="checkbox" @bind="_editingCustomer.SmsNotificationsEnabled" />
                                    SMS notifications
                                </label>
                            </div>
                        </div>

                        <div class="account-section">
                            <h3>Account Status</h3>
                            <div class="status-info">
                                <span class="status-label">Status:</span>
                                <span class="status-badge @(_selectedCustomer?.IsActive == true ? "active" : "inactive")">
                                    @(_selectedCustomer?.IsActive == true ? "Active" : "Inactive")
                                </span>
                            </div>
                            <div class="registration-info">
                                <span>Registered: @_selectedCustomer?.CreatedAt:dd.MM.yyyy</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_activeTab == "measurements")
            {
                <div class="tab-content">
                    <div class="measurements-section">
                        <h3>Physical Measurements</h3>
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Height (cm):</label>
                                <input type="number" @bind="_editingCustomer.Height" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label>Weight (kg):</label>
                                <input type="number" @bind="_editingCustomer.Weight" step="0.1" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label>Shoe Size (EU):</label>
                                <input type="number" @bind="_editingCustomer.ShoeSize" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label>Preferred Style:</label>
                                <select @bind="_editingCustomer.PreferredStyle" class="form-input">
                                    <option value="">Not specified</option>
                                    <option value="Classic">Classic</option>
                                    <option value="Skate">Skate</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Skill Level:</label>
                                <select @bind="_editingCustomer.SkillLevel" class="form-input">
                                    <option value="">Not specified</option>
                                    <option value="Beginner">Beginner</option>
                                    <option value="Intermediate">Intermediate</option>
                                    <option value="Advanced">Advanced</option>
                                    <option value="Expert">Expert</option>
                                </select>
                            </div>
                        </div>

                        <div class="calculated-info">
                            <h4>Calculated Values</h4>
                            <div class="info-grid">
                                <div class="info-item">
                                    <span>BMI:</span>
                                    <strong>@CalculateBMI(_editingCustomer)</strong>
                                </div>
                                <div class="info-item">
                                    <span>Ideal Ski Length:</span>
                                    <strong>@CalculateIdealSkiLength(_editingCustomer) cm</strong>
                                </div>
                                <div class="info-item">
                                    <span>Ideal Pole Length:</span>
                                    <strong>@CalculateIdealPoleLength(_editingCustomer) cm</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_activeTab == "rentals")
            {
                <div class="tab-content">
                    <div class="rentals-section">
                        <h3>Rental History</h3>
                        @if (_customerRentals.Any())
                        {
                            <div class="rentals-list">
                                @foreach (var rental in _customerRentals.OrderByDescending(r => r.StartTime))
                                {
                                    <div class="rental-item">
                                        <div class="rental-header">
                                            <span class="rental-id">#@rental.Id</span>
                                            <span class="rental-date">@rental.StartTime:dd.MM.yyyy</span>
                                            <span class="rental-status @rental.Status.ToString().ToLower()">
                                                @rental.Status
                                            </span>
                                        </div>
                                        <div class="rental-details">
                                            <span>Duration: @GetRentalDuration(rental)</span>
                                            <span>Equipment: @rental.RentalEquipments.Count items</span>
                                            <span>Amount: @rental.TotalAmount PLN</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="no-rentals">
                                <p>No rental history found for this customer.</p>
                            </div>
                        }
                    </div>
                </div>
            }
            </div>

            <div class="modal-actions">
                <button class="btn-secondary" @onclick="CloseDetailsModal">
                    Close
                </button>
                <button class="btn-primary" @onclick="SaveCustomerChanges" disabled="@(!HasChanges)">
                    Save Changes
                </button>
            </div>
        </div>
    }
}

@code {
    // CustomerSummary DTO
    public record CustomerSummary
    {
        public int Id { get; set; }
        public string Name { get; init; } = string.Empty;
        public string Email { get; init; } = string.Empty;
        public string Phone { get; init; } = string.Empty;
        public int ActiveRentals { get; init; }
        public decimal TotalSpent { get; init; }
        public DateTime LastRentalDate { get; init; }
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public UserProfile? Profile { get; set; }
        public bool IsActive { get; init; } = true;
        public int TotalRentals { get; init; }
        public DateTime CreatedAt { get; init; } = DateTime.UtcNow;
    }

    private List<CustomerSummary> _allCustomers = new();
    private IEnumerable<CustomerSummary> _filteredCustomers = new List<CustomerSummary>();
    private CustomerSummary? _selectedCustomer;
    private UserProfile? _editingCustomer;
    private List<Rental> _customerRentals = new();
    private bool _isLoading = true;
    private string SearchQuery = string.Empty;
    private string AccountStatusFilter = string.Empty;
    private string SortColumn = "Id";
    private bool SortAscending = true;
    private string _activeTab = "profile";

    // Confirmation modal
    private bool _showConfirmationModal;
    private string _confirmationTitle = string.Empty;
    private string _confirmationMessage = string.Empty;
    private CustomerSummary? _pendingCustomer;
    private bool _pendingActivation;

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomersAsync();
    }

    private async Task LoadCustomersAsync()
    {
        _isLoading = true;

        try
        {
            // Get all users and their profiles
            var users = await UserRepository.GetAllAsync();
            var customerIds = users.Select(u => u.Id).ToList();

            // Single grouped query instead of N+1 individual queries
            var rentalSummaries = await RentalRepository.GetRentalSummariesByCustomerIdsAsync(customerIds);

            var customers = new List<CustomerSummary>();

            foreach (var user in users)
            {
                var profile = await UserRepository.GetProfileByUserIdAsync(user.Id);
                var summary = rentalSummaries.GetValueOrDefault(user.Id, new CustomerRentalSummary());

                customers.Add(new CustomerSummary
                {
                    Id = user.Id,
                    FirstName = profile?.FirstName,
                    LastName = profile?.LastName,
                    Email = user.Username, // Assuming username is email
                    PhoneNumber = profile?.PhoneNumber ?? string.Empty,
                    IsActive = !user.IsLocked,
                    CreatedAt = user.CreatedAt,
                    TotalRentals = summary.TotalRentals,
                    TotalSpent = summary.TotalSpent,
                    LastRentalDate = summary.LastRentalDate ?? DateTime.MinValue,
                    Profile = profile
                });
            }

            _allCustomers = customers;
            ApplyFiltersAndSort();
        }
        catch (Exception ex)
        {
            // TODO: Show error message
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyFiltersAndSort()
    {
        _filteredCustomers = _allCustomers.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            _filteredCustomers = _filteredCustomers.Where(c =>
                (c.FirstName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.LastName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.Email?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.PhoneNumber?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        // Apply status filter
        if (!string.IsNullOrWhiteSpace(AccountStatusFilter))
        {
            var isActive = AccountStatusFilter == "active";
            _filteredCustomers = _filteredCustomers.Where(c => c.IsActive == isActive);
        }

        // Apply sorting
        _filteredCustomers = SortColumn switch
        {
            "Id" => SortAscending ? _filteredCustomers.OrderBy(c => c.Id) : _filteredCustomers.OrderByDescending(c => c.Id),
            "Name" => SortAscending ? _filteredCustomers.OrderBy(c => c.FirstName).ThenBy(c => c.LastName) : _filteredCustomers.OrderByDescending(c => c.FirstName).ThenByDescending(c => c.LastName),
            "Email" => SortAscending ? _filteredCustomers.OrderBy(c => c.Email) : _filteredCustomers.OrderByDescending(c => c.Email),
            "Phone" => SortAscending ? _filteredCustomers.OrderBy(c => c.PhoneNumber) : _filteredCustomers.OrderByDescending(c => c.PhoneNumber),
            "TotalRentals" => SortAscending ? _filteredCustomers.OrderBy(c => c.TotalRentals) : _filteredCustomers.OrderByDescending(c => c.TotalRentals),
            "TotalSpent" => SortAscending ? _filteredCustomers.OrderBy(c => c.TotalSpent) : _filteredCustomers.OrderByDescending(c => c.TotalSpent),
            "LastRental" => SortAscending ? _filteredCustomers.OrderBy(c => c.LastRentalDate) : _filteredCustomers.OrderByDescending(c => c.LastRentalDate),
            _ => _filteredCustomers
        };

        _filteredCustomers = _filteredCustomers.ToList();
    }

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        
        ApplyFiltersAndSort();
    }

    private string GetSortIcon(string column)
    {
        if (SortColumn != column) return "⇅";
        return SortAscending ? "↑" : "↓";
    }

    private void SortById() => SortBy("Id");
    private void SortByName() => SortBy("Name");
    private void SortByEmail() => SortBy("Email");
    private void SortByPhone() => SortBy("Phone");
    private void SortByTotalRentals() => SortBy("TotalRentals");
    private void SortByTotalSpent() => SortBy("TotalSpent");
    private void SortByLastRental() => SortBy("LastRental");

    private void ShowProfileTab() => _activeTab = "profile";
    private void ShowMeasurementsTab() => _activeTab = "measurements";
    private void ShowRentalsTab() => _activeTab = "rentals";

    private void SelectCustomer(CustomerSummary customer)
    {
        _selectedCustomer = customer;
        _editingCustomer = CreateEditableCustomer(customer);
        _activeTab = "profile";
        _ = LoadCustomerRentals(customer.Id);
    }

    private async Task LoadCustomerRentals(int customerId)
    {
        try
        {
            _customerRentals = (await RentalRepository.GetByCustomerIdAsync(customerId)).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customer rentals: {ex.Message}");
            _customerRentals = new List<Rental>();
        }
    }

    private UserProfile CreateEditableCustomer(CustomerSummary customer)
    {
        return new UserProfile
        {
            Id = customer.Id,
            FirstName = customer.FirstName ?? string.Empty,
            LastName = customer.LastName ?? string.Empty,
            Email = customer.Email,
            PhoneNumber = customer.PhoneNumber,
            Height = customer.Profile?.Height ?? 0,
            Weight = customer.Profile?.Weight ?? 0,
            ShoeSize = customer.Profile?.ShoeSize ?? 0,
            PreferredStyle = customer.Profile?.PreferredStyle ?? SkiStyle.Classic,
            SkillLevel = customer.Profile?.SkillLevel ?? SkillLevel.Beginner,
            EmailNotificationsEnabled = customer.Profile?.EmailNotificationsEnabled ?? true,
            SmsNotificationsEnabled = customer.Profile?.SmsNotificationsEnabled ?? true
        };
    }

    private void CloseDetailsModal()
    {
        _selectedCustomer = null;
        _editingCustomer = null;
        _customerRentals.Clear();
    }

    private async Task SaveCustomerChanges()
    {
        if (_editingCustomer == null || _selectedCustomer == null) return;

        try
        {
            await UserRepository.UpsertProfileAsync(_selectedCustomer.Id, _editingCustomer);
            
            // Update local data
            _selectedCustomer.FirstName = _editingCustomer.FirstName;
            _selectedCustomer.LastName = _editingCustomer.LastName;
            _selectedCustomer.PhoneNumber = _editingCustomer.PhoneNumber;
            _selectedCustomer.Profile = _editingCustomer;
            
            await LoadCustomersAsync(); // Refresh data
            CloseDetailsModal();
        }
        catch (Exception ex)
        {
            // TODO: Show error message
            Console.WriteLine($"Error saving customer: {ex.Message}");
        }
    }

    private void EditCustomer(CustomerSummary customer)
    {
        SelectCustomer(customer);
        _activeTab = "profile";
    }

    private async Task DeactivateCustomer(CustomerSummary customer)
    {
        _pendingCustomer = customer;
        _pendingActivation = false;
        _confirmationTitle = "Deactivate Account";
        _confirmationMessage = $"Are you sure you want to deactivate {customer.FirstName} {customer.LastName}'s account? They will not be able to log in or make new bookings.";
        _showConfirmationModal = true;
    }

    private async Task ActivateCustomer(CustomerSummary customer)
    {
        _pendingCustomer = customer;
        _pendingActivation = true;
        _confirmationTitle = "Activate Account";
        _confirmationMessage = $"Are you sure you want to activate {customer.FirstName} {customer.LastName}'s account? They will be able to log in and make bookings again.";
        _showConfirmationModal = true;
    }

    private void CloseConfirmationModal()
    {
        _showConfirmationModal = false;
        _pendingCustomer = null;
    }

    private async Task ConfirmAction()
    {
        if (_pendingCustomer == null) return;

        try
        {
            var result = await UserService.SetLockAsync(_pendingCustomer.Id, !_pendingActivation);

            if (result.IsSuccess)
            {
                // Send notification to customer
                var profile = await UserRepository.GetProfileByUserIdAsync(_pendingCustomer.Id);
                if (profile != null)
                {
                    var notification = new NotificationPayload
                    {
                        Subject = _pendingActivation ? "Your SkiRental account has been activated" : "Your SkiRental account has been deactivated",
                        Body = _pendingActivation
                            ? "Good news! Your SkiRental account has been reactivated. You can now log in and book equipment again."
                            : "Your SkiRental account has been temporarily deactivated. Please contact support if you have any questions.",
                        TemplateData = new Dictionary<string, string>
                        {
                            { "CustomerName", $"{profile.FirstName} {profile.LastName}" }
                        }
                    };

                    if (!string.IsNullOrEmpty(profile.Email) && profile.EmailNotificationsEnabled)
                    {
                        await NotificationService.SendEmailAsync(profile.Email, notification);
                    }

                    if (!string.IsNullOrEmpty(profile.PhoneNumber) && profile.SmsNotificationsEnabled)
                    {
                        await NotificationService.SendSmsAsync(profile.PhoneNumber, notification);
                    }
                }

                await LoadCustomersAsync();
            }
            else
            {
                // TODO: Show error message
                Console.WriteLine($"Error: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error changing account status: {ex.Message}");
        }
        finally
        {
            CloseConfirmationModal();
        }
    }

    private bool HasChanges => _editingCustomer != null && _selectedCustomer != null &&
        (_editingCustomer.FirstName != _selectedCustomer.FirstName ||
         _editingCustomer.LastName != _selectedCustomer.LastName ||
         _editingCustomer.PhoneNumber != _selectedCustomer.PhoneNumber ||
         _editingCustomer.EmailNotificationsEnabled != (_selectedCustomer.Profile?.EmailNotificationsEnabled ?? true) ||
         _editingCustomer.SmsNotificationsEnabled != (_selectedCustomer.Profile?.SmsNotificationsEnabled ?? true));

    private async Task RefreshData()
    {
        await LoadCustomersAsync();
    }

    private static decimal CalculateBMI(UserProfile profile)
    {
        if (profile.Height <= 0 || profile.Weight <= 0) return 0;
        var heightInMeters = profile.Height / 100.0m;
        return Math.Round(profile.Weight / (heightInMeters * heightInMeters), 1);
    }

    private static decimal CalculateIdealSkiLength(UserProfile profile)
    {
        if (profile.Height <= 0) return 0;
        var offset = profile.PreferredStyle == SkiStyle.Skate ? 12.5m : 25m;
        return Math.Round(profile.Height + offset, 0);
    }

    private static decimal CalculateIdealPoleLength(UserProfile profile)
    {
        if (profile.Height <= 0) return 0;
        var multiplier = profile.PreferredStyle == SkiStyle.Skate ? 0.90m : 0.85m;
        return Math.Round(profile.Height * multiplier, 0);
    }

    private static string GetRentalDuration(Rental rental)
    {
        var duration = rental.EndTime - rental.StartTime;
        var days = duration.Days;
        var hours = duration.Hours;
        
        if (days > 0)
            return $"{days}d {hours}h";
        
        return $"{hours}h";
    }
}
}
