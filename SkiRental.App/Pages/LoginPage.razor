@page "/login"
@using System.ComponentModel.DataAnnotations
@using SkiRental.App.Services
@inject AuthenticationService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Logowanie | SkiRental</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-logo">
                <h1>🎿</h1>
                <h2>SkiRental</h2>
            </div>
            <p class="login-subtitle">Zaloguj się do swojego konta</p>
        </div>

        <EditForm Model="@_model" OnValidSubmit="@HandleLogin" class="login-form">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="error-message" role="alert">
                    @_errorMessage
                </div>
            }

            @if (_successMessage is not null)
            {
                <div class="success-message" role="status">@_successMessage</div>
            }

            <div class="form-group">
                <label for="username">Nazwa użytkownika</label>
                <InputText id="username" class="form-input" @bind-Value="_model.Username"
                           placeholder="Wprowadź nazwę użytkownika"
                           autocomplete="username" />
                <ValidationMessage For="@(() => _model.Username)" />
            </div>

            <div class="form-group">
                <label for="password">Hasło</label>
                <div class="password-input-wrapper">
                    <InputText type="@_passwordType" id="password" class="form-input"
                               @bind-Value="_model.Password"
                               placeholder="Wprowadź hasło"
                               autocomplete="current-password" />
                    <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility"
                            aria-label="Pokaż/ukryj hasło">
                        @_passwordIcon
                    </button>
                </div>
                <ValidationMessage For="@(() => _model.Password)" />
            </div>

            <div class="form-options">
                <label class="checkbox-wrapper">
                    <InputCheckbox @bind-Value="_model.RememberMe" />
                    <span class="checkmark"></span>
                    Zapamiętaj mnie
                </label>
            </div>

            <button type="submit" class="login-button" disabled="@_isLoggingIn">
                @if (_isLoggingIn)
                {
                    <span class="spinner"></span>
                    <span>Logowanie...</span>
                }
                else
                {
                    <span>Zaloguj się</span>
                }
            </button>
        </EditForm>

        @* Social login — not implemented in current version *@
        <div class="login-divider"><span>lub</span></div>
        <div class="social-login">
            <button class="social-button google" disabled title="Logowanie przez Google – wkrótce dostępne">
                <span class="social-icon">🌐</span>
                Google (wkrótce)
            </button>
            <button class="social-button facebook" disabled title="Logowanie przez Facebook – wkrótce dostępne">
                <span class="social-icon">📘</span>
                Facebook (wkrótce)
            </button>
        </div>

        <div class="login-footer">
            <p>Nie masz jeszcze konta? <a href="/register" class="register-link">Zarejestruj się</a></p>
        </div>

#if DEBUG
        @* Demo credentials helper — stripped from Release builds *@
        <div class="debug-hint">
            <strong>Demo:</strong><br />
            owner / owner123 (Właściciel)<br />
            worker / worker123 (Pracownik)<br />
            user / user123 (Klient)
        </div>
#endif
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private bool _isLoggingIn;
    private string _passwordType = "password";
    private string _passwordIcon = "👁️";
    private string? _errorMessage;
    private string? _successMessage;

    // Redirect immediately if already logged in
    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
            NavigationManager.NavigateTo("/");
    }

    private async Task HandleLogin()
    {
        _isLoggingIn  = true;
        _errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(_model.Username, _model.Password, _model.RememberMe);

            if (result.Success)
                NavigationManager.NavigateTo("/");
            else
                _errorMessage = result.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd połączenia: {ex.Message}";
        }
        finally
        {
            _isLoggingIn = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        if (_passwordType == "password")
        {
            _passwordType = "text";
            _passwordIcon = "🙈";
        }
        else
        {
            _passwordType = "password";
            _passwordIcon = "👁️";
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Nazwa użytkownika jest wymagana")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "Nazwa użytkownika musi mieć 3–100 znaków")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Hasło jest wymagane")]
        [StringLength(100, MinimumLength = 6, ErrorMessage = "Hasło musi mieć od 6 do 100 znaków")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
