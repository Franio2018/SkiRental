@page "/no-match"
@using SkiRental.Domain.Models
@using SkiRental.Domain.Enums
@using SkiRental.App.Services
@using SkiRental.Logic
@using Microsoft.Extensions.Options
@using SkiRental.Logic.Options

@inject NavigationManager Navigation
@inject BookingStateService BookingState
@inject IOptions<SkiRentalOptions> SkiOpts
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Brak dopasowania sprzętu | SkiRental</PageTitle>

<div class="no-match-page">
    <div class="no-match-container">
        <div class="error-header">
            <div class="error-icon">@( _skisMissing ? "🎿" : "⚠️")</div>
            <h1>@_title</h1>
            <p class="subtitle">@_lead</p>
            @if (_skisMissing)
            {
                <div class="alert-box alert-box--skis">
                    <strong>Co to oznacza?</strong>
                    <p>
                        Narty są podstawą pakietu. Skontaktuj się z ladą wypożyczalni —
                        pracownik może zaproponować inny rozmiar z magazynu lub rezerwację
                        na inny termin, gdy sprzęt wróci od innych klientów.
                    </p>
                </div>
            }
            else
            {
                <div class="alert-box">
                    <strong>Pełny pakiet to:</strong>
                    <p>@RecommendationUserMessages.FormatRequiredPackage()</p>
                    <p>Bez wszystkich trzech elementów nie możemy dokończyć rezerwacji w aplikacji.</p>
                </div>
            }
        </div>

        @if (_noMatchReasons.Any())
        {
            <div class="reasons-section">
                <h2>Szczegóły braków:</h2>
                <div class="reason-cards">
                    @foreach (var reason in _noMatchReasons)
                    {
                        <div class="reason-card @(reason.Category == EquipmentCategory.Skis ? "reason-card--skis" : "")">
                            <div class="reason-header">
                                <span class="category-icon">@GetCategoryIcon(reason.Category)</span>
                                <h3>@RecommendationUserMessages.CategoryNamePl(reason.Category)</h3>
                            </div>
                            <div class="reason-details">
                                <p class="constraint">@reason.ConstraintDescription</p>
                                <div class="size-comparison">
                                    <div class="ideal-size">
                                        <strong>Twój idealny rozmiar:</strong>
                                        @reason.IdealSize@(GetUnit(reason.Category))
                                    </div>
                                    <div class="available-range">
                                        <strong>Dostępne w magazynie:</strong> @reason.AvailableSizes
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="help-section">
            <h2>Co możesz zrobić:</h2>
            <div class="help-options">
                <div class="help-option">
                    <div class="option-icon">📞</div>
                    <div>
                        <h3>Skontaktuj się z ladą</h3>
                        <p>Pracownik sprawdzi magazyn i zaproponuje alternatywy</p>
                    </div>
                </div>
                <div class="help-option">
                    <div class="option-icon">🔄</div>
                    <div>
                        <h3>Zaktualizuj profil</h3>
                        <p>Sprawdź wzrost, wagę, rozmiar buta i styl jazdy</p>
                    </div>
                </div>
                <div class="help-option">
                    <div class="option-icon">📅</div>
                    <div>
                        <h3>Spróbuj później</h3>
                        <p>Sprzęt wraca na stan magazynu po zwrotach innych klientów</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="action-section">
            <div class="contact-info">
                <h3>Kontakt do wypożyczalni</h3>
                <p><strong>Telefon:</strong> @SkiOpts.Value.SupportPhone</p>
                <p><strong>E-mail:</strong> @SkiOpts.Value.SupportEmail</p>
                <p><strong>Godziny:</strong> 8:00 – 18:00</p>
            </div>

            <div class="action-buttons">
                <button type="button" class="btn-secondary" onclick="navBridge.go('/profile?returnUrl=/booking')">
                    ← Popraw profil
                </button>
                <button type="button" class="btn-primary" onclick="navBridge.go('/')">
                    🏠 Strona główna
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private DotNetObjectReference<NoMatchPage>? _dotNetRef;
    private List<NoMatchReason> _noMatchReasons = [];
    private string _title = "";
    private string _lead = "";
    private bool _skisMissing;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("navBridgeInit", _dotNetRef);
        }
    }

    public void Dispose() => _dotNetRef?.Dispose();

    [JSInvokable]
    public Task JsNavigate(string path) => InvokeAsync(() =>
    {
        Navigation.NavigateTo(path);
        return Task.CompletedTask;
    });

    protected override void OnInitialized()
    {
        var recommendationResult = BookingState.GetNoMatchState();
        BookingState.ClearNoMatchState();

        if (recommendationResult?.NoMatchReasons is not { Count: > 0 })
        {
            Navigation.NavigateTo("/booking");
            return;
        }

        _noMatchReasons = recommendationResult.NoMatchReasons.ToList();
        _skisMissing = RecommendationUserMessages.HasSkisNoMatch(_noMatchReasons);
        _title = RecommendationUserMessages.GetNoMatchTitle(_noMatchReasons);
        _lead = RecommendationUserMessages.GetNoMatchLead(_noMatchReasons);
    }

    private static string GetCategoryIcon(EquipmentCategory category) => category switch
    {
        EquipmentCategory.Skis => "🎿",
        EquipmentCategory.Poles => "🦯",
        EquipmentCategory.Boots => "🥾",
        _ => "📦"
    };

    private static string GetUnit(EquipmentCategory category) => category switch
    {
        EquipmentCategory.Skis => " cm",
        EquipmentCategory.Poles => " cm",
        EquipmentCategory.Boots => " EU",
        _ => ""
    };
}
