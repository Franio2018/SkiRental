@page "/profile"
@using SkiRental.Domain.Models
@using SkiRental.Domain.Enums
@using SkiRental.App.Services
@using SkiRental.Logic.Services
@inject AuthenticationService Auth
@inject UserService UserSvc
@inject ProfilePictureService ProfilePictureSvc
@inject NavigationManager Nav

<PageTitle>Profil | SkiRental</PageTitle>

<div class="page-container">
    <nav class="breadcrumb">
        <a href="/">Strona główna</a> / Profil
    </nav>

    @if (!Auth.IsAuthenticated)
    {
        <div class="auth-required">
            <p>Musisz być zalogowany, aby zobaczyć profil.</p>
            <a href="/login" class="btn-primary">Zaloguj się</a>
        </div>
        return;
    }

    @if (_loading)
    {
        <div class="wizard-step">
            <div class="loading-spinner">
                <div class="spinner"></div>
                <p>Wczytujemy profil...</p>
            </div>
        </div>
        return;
    }

    <div class="profile-container">
        @* Header *@
        <div class="profile-header">
            <div class="profile-avatar-section">
                <div class="profile-avatar" @onclick="TriggerFileUpload">
                    @if (!string.IsNullOrEmpty(_profile?.ProfileImagePath))
                    {
                        <img src="@GetProfileImageUrl()" alt="Zdjęcie profilowe" class="avatar-image" />
                    }
                    else
                    {
                        <div class="avatar-placeholder">
                            @((_profile?.FirstName?.FirstOrDefault() ?? Auth.CurrentUsername?.FirstOrDefault() ?? '?').ToString().ToUpper())
                        </div>
                    }
                    <div class="avatar-overlay"><span>✏️</span></div>
                </div>
                <InputFile OnChange="OnAvatarSelected" accept="image/*" style="display:none" id="avatar-input" />
            </div>

            <div class="profile-info">
                @if (_profile is not null)
                {
                    <h1>@_profile.FirstName @_profile.LastName</h1>
                    @if (_profile.Age.HasValue)
                    {
                        <p class="profile-age">Wiek: @_profile.Age lat</p>
                    }
                    <p class="profile-member">Konto od: @_userCreatedAt?.ToString("dd.MM.yyyy")</p>
                }
                else
                {
                    <h1>@Auth.CurrentUsername</h1>
                    <p class="profile-hint">Uzupełnij profil, aby korzystać z Asystenta dopasowania sprzętu.</p>
                }
                <span class="role-badge role-@Auth.CurrentRole.ToString().ToLower()">
                    @RoleLabel(Auth.CurrentRole)
                </span>
            </div>
        </div>

        @* Save/error feedback *@
        @if (_saveSuccess)
        {
            <div class="success-message">✅ Profil zapisany pomyślnie.</div>
        }
        @if (_saveError is not null)
        {
            <div class="error-message">@_saveError</div>
        }

        @* Tabs *@
        <div class="profile-tabs">
            @foreach (var tab in new[] { ("personal", "Dane osobowe"), ("physical", "Dane fizyczne"),
                                         ("preferences", "Preferencje"), ("statistics", "Statystyki") })
            {
                <button class="tab-btn @(_activeTab == tab.Item1 ? "active" : "")"
                        @onclick="() => _activeTab = tab.Item1">
                    @tab.Item2
                </button>
            }
        </div>

        <div class="profile-content">
            @* ── Personal data ── *@
            @if (_activeTab == "personal")
            {
                <div class="profile-section">
                    <h3>Dane osobowe</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Imię</label>
                            <input type="text" @bind="Profile.FirstName" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Nazwisko</label>
                            <input type="text" @bind="Profile.LastName" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" @bind="Profile.Email" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Telefon</label>
                            <input type="tel" @bind="Profile.PhoneNumber" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Data urodzenia</label>
                            <input type="date" @bind="Profile.DateOfBirth" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Miasto</label>
                            <input type="text" @bind="Profile.City" class="form-input" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Adres</label>
                        <input type="text" @bind="Profile.Address" class="form-input" />
                    </div>
                    <div class="notification-settings">
                        <h4>Powiadomienia</h4>
                        <div class="checkbox-group">
                            <label>
                                <input type="checkbox" @bind="Profile.EmailNotificationsEnabled" />
                                Powiadomienia email
                            </label>
                            <label>
                                <input type="checkbox" @bind="Profile.SmsNotificationsEnabled" />
                                Powiadomienia SMS
                            </label>
                        </div>
                    </div>
                    <button class="btn-primary" @onclick="SaveProfile" disabled="@_saving">
                        @(_saving ? "Zapisuję..." : "Zapisz zmiany")
                    </button>
                </div>
            }

            @* ── Physical data ── *@
            @if (_activeTab == "physical")
            {
                <div class="profile-section">
                    <h3>Dane fizyczne</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Wzrost (cm)</label>
                            <input type="number" @bind="Profile.Height" min="100" max="250" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Waga (kg)</label>
                            <input type="number" @bind="Profile.Weight" step="0.5" min="30" max="300" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Rozmiar buta (EU)</label>
                            <input type="number" @bind="Profile.ShoeSize" min="30" max="55" class="form-input" />
                        </div>
                        <div class="form-group">
                            <label>Poziom zaawansowania</label>
                            <select @bind="Profile.SkillLevel" class="form-input">
                                <option value="@SkillLevel.Beginner">Początkujący</option>
                                <option value="@SkillLevel.Intermediate">Średnio zaawansowany</option>
                                <option value="@SkillLevel.Advanced">Zaawansowany</option>
                                <option value="@SkillLevel.Expert">Ekspert</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Styl jazdy</label>
                            <select @bind="Profile.PreferredStyle" class="form-input">
                                <option value="@SkiStyle.Classic">Klasyczny</option>
                                <option value="@SkiStyle.Skate">Skate</option>
                                <option value="@SkiStyle.Combi">Kombinowany</option>
                            </select>
                        </div>
                    </div>
                    <button class="btn-primary" @onclick="SaveProfile" disabled="@_saving">
                        @(_saving ? "Zapisuję..." : "Zapisz zmiany")
                    </button>
                </div>
            }

            @* ── Preferences ── *@
            @if (_activeTab == "preferences")
            {
                <div class="profile-section">
                    <h3>Preferencje narciarskie</h3>
                    <div class="form-group">
                        <label>Ulubione trasy</label>
                        <textarea @bind="Profile.FavoriteRoutes" class="form-input" rows="4"
                                  placeholder="Opisz swoje ulubione trasy, poziom trudności, warunki..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>Notatki o preferencjach</label>
                        <textarea @bind="Profile.PreferenceNotes" class="form-input" rows="5"
                                  placeholder="Dodatkowe uwagi o preferencjach sprzętu, stylu jazdy, itp."></textarea>
                    </div>
                    <button class="btn-primary" @onclick="SaveProfile" disabled="@_saving">
                        @(_saving ? "Zapisuję..." : "Zapisz zmiany")
                    </button>
                </div>
            }

            @* ── Statistics ── *@
            @if (_activeTab == "statistics")
            {
                <div class="profile-section">
                    <h3>Statystyki wypożyczeń</h3>
                    @if (_profile is not null)
                    {
                        <div class="stats-grid">
                            <div class="stat-card">
                                <div class="stat-value">@_profile.TotalRentalsCount</div>
                                <div class="stat-label">Wypożyczenia</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-value">@_profile.TotalSkiDays</div>
                                <div class="stat-label">@SkiDaysLabel(_profile.TotalSkiDays)</div>
                            </div>
                            <div class="stat-card">
                                <div class="stat-value">
                                    @(_profile.LastRentalDate?.ToString("dd.MM.yyyy") ?? "—")
                                </div>
                                <div class="stat-label">Ostatnie wypożyczenie</div>
                            </div>
                            @if (_profile.FavoriteEquipmentCategory.HasValue)
                            {
                                <div class="stat-card">
                                    <div class="stat-value">@_profile.FavoriteEquipmentCategory</div>
                                    <div class="stat-label">Ulubiony sprzęt</div>
                                </div>
                            }
                        </div>

                        @if (_profile.Rentals?.Any() == true)
                        {
                            <h4>Ostatnie wypożyczenia</h4>
                            <div class="rentals-list">
                                @foreach (var rental in _profile.Rentals
                                    .OrderByDescending(r => r.StartTime).Take(5))
                                {
                                    <div class="rental-item">
                                        <div class="rental-date">@rental.StartTime.ToString("dd.MM.yyyy")</div>
                                        <div class="rental-equipment-count">
                                            @rental.RentalEquipments.Count szt.
                                        </div>
                                        <div class="rental-amount">@rental.TotalAmount.ToString("N2") zł</div>
                                        <div class="rental-status @rental.Status.ToString().ToLower()">
                                            @rental.Status
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="no-data">Brak historii wypożyczeń.</p>
                        }
                    }
                    else
                    {
                        <p class="no-data">Uzupełnij profil, aby zobaczyć statystyki.</p>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private UserProfile? _profile;
    private bool _loading = true;
    private bool _saving;
    private bool _saveSuccess;
    private string? _saveError;
    private string _activeTab = "personal";
    private DateTime? _userCreatedAt;

    // Working copy — always non-null after init so bindings never crash
    private UserProfile Profile => _profile ??= new UserProfile
    {
        CreatedAt       = DateTime.UtcNow,
        SkillLevel      = SkillLevel.Beginner,
        PreferredStyle  = SkiStyle.Classic
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            _loading = false;
            return;
        }

        try
        {
            _profile = await UserSvc.GetProfileAsync(Auth.CurrentUserId!.Value);
        }
        catch (Exception ex)
        {
            _saveError = $"Błąd ładowania profilu: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveProfile()
    {
        _saving      = true;
        _saveSuccess = false;
        _saveError   = null;

        try
        {
            _profile = await UserSvc.SaveProfileAsync(Auth.CurrentUserId!.Value, Profile);
            _saveSuccess = true;

            // Auto-dismiss success message after 3s
            _ = Task.Delay(3000).ContinueWith(_ =>
            {
                _saveSuccess = false;
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            _saveError = $"Błąd zapisu: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task TriggerFileUpload()
    {
        await Task.CompletedTask;
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        if (Auth.CurrentUserId is null || _profile is null) return;
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024) { _saveError = "Maksymalny rozmiar zdjęcia to 5 MB."; return; }

        try
        {
            await using var stream = file.OpenReadStream(5 * 1024 * 1024);
            var fileName = await ProfilePictureSvc.UploadProfilePictureAsync(
                Auth.CurrentUserId.Value, stream, file.Name);
            _profile.ProfileImagePath = fileName;
            _profile = await UserSvc.SaveProfileAsync(Auth.CurrentUserId.Value, _profile);
            _saveSuccess = true;
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
        }
    }

    private string GetProfileImageUrl()
    {
        if (string.IsNullOrEmpty(_profile?.ProfileImagePath)) return string.Empty;
        return ProfilePictureSvc.GetProfilePicturePath(_profile.ProfileImagePath) ?? string.Empty;
    }

    private static string RoleLabel(AppRole role) => role switch
    {
        AppRole.Owner  => "Właściciel",
        AppRole.Worker => "Pracownik",
        _              => "Klient"
    };

    private static string SkiDaysLabel(int days) => days switch
    {
        1 => "dzień na nartach",
        _ => "dni na nartach"
    };
}
