@page "/recommendation-loading"
@using SkiRental.Domain.Models
@using SkiRental.Domain.Enums
@using SkiRental.Logic.Interfaces
@using SkiRental.App.Services
@using Microsoft.AspNetCore.Components

@inject IRecommendationOrchestrator RecommendationOrchestrator
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject BookingStateService BookingState

<PageTitle>Calculating Recommendations - SkiRental</PageTitle>

<div class="recommendation-loading-page">
    <div class="loading-container">
        @if (_isLoading)
        {
            <div class="loading-animation">
                <div class="ski-loader">
                    <div class="ski-icon">🎿</div>
                    <div class="track"></div>
                </div>
                <h2>Finding your perfect gear...</h2>
                <p class="loading-subtitle">Our Intelligent Assistant is analyzing your profile</p>
            </div>

            <div class="algorithm-explanation">
                <h3>How we're matching your gear</h3>
                <div class="explanation-text">
                    @if (!string.IsNullOrEmpty(_currentExplanation))
                    {
                        @_currentExplanation
                    }
                    else
                    {
                        <div class="placeholder-dots">
                            <span>.</span><span>.</span><span>.</span>
                        </div>
                    }
                </div>
            </div>
        }
        else if (_result != null)
        {
            <div class="result-ready">
                <div class="success-icon">✅</div>
                <h2>Recommendations Ready!</h2>
                <p>We've found the perfect gear for your skiing adventure.</p>
            </div>
        }
        else if (_errorMessage != null)
        {
            <div class="error-state">
                <div class="error-icon">❌</div>
                <h2>Something went wrong</h2>
                <p>@_errorMessage</p>
                <div class="error-actions">
                    <button class="btn-secondary" @onclick="GoHome">Go to Home</button>
                    <button class="btn-primary" @onclick="GoToBooking">Start New Booking</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public EquipmentSelectionParameters? Parameters { get; set; }

    private bool _isLoading = true;
    private RecommendationResult? _result;
    private string? _errorMessage;
    private string _currentExplanation = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Parameters = BookingState.GetSelectionParameters();

        if (Parameters == null)
        {
            _errorMessage = "No booking parameters found. Please start a new booking from the home page.";
            _isLoading = false;
            return;
        }

        await Task.Delay(500); // Brief pause for UX

        try
        {
            // Start streaming the algorithm explanation
            _ = StreamExplanationAsync();

            // Calculate recommendations
            _result = await RecommendationOrchestrator.RecommendAsync(Parameters);

            if (_result.Status == RecommendationStatus.NoMatch)
            {
                // Store no-match state in BookingStateService
                BookingState.SetNoMatchState(_result);
                Navigation.NavigateTo("/no-match");
                return;
            }

            // Store result in BookingStateService
            BookingState.SetRecommendationResult(_result);
            _isLoading = false;

            // Auto-navigate after a short delay
            await Task.Delay(2000);
            Navigation.NavigateTo("/gear-review");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error calculating recommendations: {ex.Message}";
            _isLoading = false;
        }
    }

    private async Task StreamExplanationAsync()
    {
        if (Parameters == null) return;
        
        var explanation = BuildStreamingExplanation(Parameters);
        var words = explanation.Split(' ');
        
        for (int i = 0; i < words.Length; i++)
        {
            _currentExplanation = string.Join(" ", words[0..i]);
            StateHasChanged();
            await Task.Delay(100); // Brief pause for typing effect
        }
        
        // Ensure final state is rendered
        StateHasChanged();
    }

    private static string BuildStreamingExplanation(EquipmentSelectionParameters parameters)
    {
        var style = parameters.Style == SkiStyle.Classic ? "Classic" : "Skate";
        var bmiStatus = parameters.IsBmiNormal ? "normal" : 
                       parameters.IsOverweight ? "higher" : "lower";

        return $"Analyzing your {style} skiing profile... " +
               $"Based on your {parameters.Height}cm height and {parameters.Weight}kg weight, " +
               $"we're calculating optimal ski length... " +
               $"Your BMI of {parameters.Bmi} is {bmiStatus} than average, " +
               $"so we'll adjust accordingly... " +
               $"Determining ideal pole length for {style} technique... " +
               $"Selecting appropriate stiffness for your {parameters.SkillLevel} skill level... " +
               $"Checking available inventory in your size range... " +
               $"Scoring options by fit and usage... " +
               $"Almost done...";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/booking");
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void GoToBooking()
    {
        Navigation.NavigateTo("/booking");
    }
}
