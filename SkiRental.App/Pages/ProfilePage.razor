    private string ActiveTab { get; set; } = "personal";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserProfile();
    }

    private async Task LoadUserProfile()
    {
        // TODO: Replace with actual user ID from authentication
        var userId = 1;
        CurrentUserProfile = await GetCurrentUserProfileAsync(userId);
    }

    private async Task<UserProfile?> GetCurrentUserProfileAsync(int userId)
    {
        // TODO: Implement actual database call
        // For now, return sample data
        return new UserProfile
        {
            Id = userId,
            FirstName = "Jan",
            LastName = "Kowalski",
            Email = "jan.kowalski@example.com",
            PhoneNumber = "+48 123 456 789",
            DateOfBirth = new DateTime(1990, 5, 15),
            City = "Zakopane",
            Address = "ul. Krupówki 12",
            Height = 175,
            Weight = 75m,
            ShoeSize = 42,
            SkillLevel = SkillLevel.Intermediate,
            PreferredStyle = SkiStyle.Classic,
            EmailNotificationsEnabled = true,
            SmsNotificationsEnabled = false,
            FavoriteRoutes = "Trasy niebieskie w Kasprowym Wierchu, szlaki w Dolinie Bystrej",
            PreferenceNotes = "Wolę spokojne trasy, unikam bardzo stromych zjazdów. Preferuję sprzęt marki Fischer.",
            CreatedAt = DateTime.UtcNow.AddMonths(-6),
            Rentals = new List<Rental>() // TODO: Load actual rentals
        };
    }

    private void TriggerFileUpload()
    {
        // For now, we'll just show the file input directly
        // In a real implementation, you'd use JavaScript interop to trigger the click
    }

    private void SwitchToPersonalTab() => ActiveTab = "personal";
    private void SwitchToPhysicalTab() => ActiveTab = "physical";
    private void SwitchToPreferencesTab() => ActiveTab = "preferences";
    private void SwitchToStatisticsTab() => ActiveTab = "statistics";

    // Placeholder for file upload - will be implemented with proper JS interop
    private async Task HandleFileUpload(ChangeEventArgs e)
    {
        // This is a simplified version - in a real app you'd use JS interop to get file data
        // For now, we'll just simulate the upload
        if (CurrentUserProfile != null)
        {
            try
            {
                // Simulate file upload
                await Task.Delay(500);
                
                // For demo purposes, set a placeholder image path
                CurrentUserProfile.ProfileImagePath = $"user_{CurrentUserProfile.Id}_demo.jpg";
                await SaveProfile();
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error uploading profile picture: {ex.Message}");
            }
        }
    }

    private string GetProfileImageUrl()
    {
        if (string.IsNullOrEmpty(CurrentUserProfile?.ProfileImagePath))
            return string.Empty;

        var fullPath = ProfilePictureService.GetProfilePicturePath(CurrentUserProfile.ProfileImagePath);
        return !string.IsNullOrEmpty(fullPath) ? fullPath : string.Empty;
    }

    private async Task SaveProfile()
    {
        // TODO: Implement actual save logic
        CurrentUserProfile!.UpdatedAt = DateTime.UtcNow;
        await Task.Delay(300); // Simulate save
        StateHasChanged();
    }
}
