@page "/register"
@using System.ComponentModel.DataAnnotations
@using SkiRental.App.Services
@inject AuthenticationService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Rejestracja | SkiRental</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-logo">
                <h1>🎿</h1>
                <h2>SkiRental</h2>
            </div>
            <p class="login-subtitle">Utwórz konto klienta</p>
        </div>

        @if (_registered)
        {
            <div class="success-message">
                ✅ Rejestracja zakończona pomyślnie!<br />
                Możesz się teraz <a href="/login">zalogować</a>.
            </div>
        }
        else
        {
            <EditForm Model="@_model" OnValidSubmit="@HandleRegister" class="login-form">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="error-message" role="alert">@_errorMessage</div>
                }

                <div class="form-group">
                    <label for="reg-username">Nazwa użytkownika</label>
                    <InputText id="reg-username" class="form-input" @bind-Value="_model.Username"
                               placeholder="Minimum 3 znaki" autocomplete="username" />
                    <ValidationMessage For="@(() => _model.Username)" />
                </div>

                <div class="form-group">
                    <label for="reg-password">Hasło</label>
                    <div class="password-input-wrapper">
                        <InputText type="@_passwordType" id="reg-password" class="form-input"
                                   @bind-Value="_model.Password"
                                   placeholder="Minimum 8 znaków"
                                   autocomplete="new-password" />
                        <button type="button" class="password-toggle" @onclick="TogglePassword">
                            @_passwordIcon
                        </button>
                    </div>
                    <ValidationMessage For="@(() => _model.Password)" />
                </div>

                <div class="form-group">
                    <label for="reg-confirm">Powtórz hasło</label>
                    <InputText type="@_passwordType" id="reg-confirm" class="form-input"
                               @bind-Value="_model.ConfirmPassword"
                               placeholder="Powtórz hasło"
                               autocomplete="new-password" />
                    <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                </div>

                <div class="form-group">
                    <label class="checkbox-wrapper">
                        <InputCheckbox @bind-Value="_model.AcceptsTerms" />
                        <span class="checkmark"></span>
                        Akceptuję <a href="/terms" target="_blank">regulamin</a> i
                        <a href="/privacy" target="_blank">politykę prywatności</a>
                    </label>
                    <ValidationMessage For="@(() => _model.AcceptsTerms)" />
                </div>

                <button type="submit" class="login-button" disabled="@_isWorking">
                    @if (_isWorking)
                    {
                        <span class="spinner"></span>
                        <span>Rejestracja...</span>
                    }
                    else
                    {
                        <span>Zarejestruj się</span>
                    }
                </button>
            </EditForm>
        }

        <div class="login-footer">
            <p>Masz już konto? <a href="/login" class="register-link">Zaloguj się</a></p>
        </div>
    </div>
</div>

@code {
    private readonly RegisterModel _model = new();
    private bool _isWorking;
    private bool _registered;
    private string? _errorMessage;
    private string _passwordType = "password";
    private string _passwordIcon = "👁️";

    protected override void OnInitialized()
    {
        if (AuthService.IsAuthenticated)
            NavigationManager.NavigateTo("/");
    }

    private async Task HandleRegister()
    {
        _isWorking    = true;
        _errorMessage = null;

        try
        {
            var result = await AuthService.RegisterAsync(
                _model.Username, _model.Password, _model.ConfirmPassword);

            if (result.Success)
                _registered = true;
            else
                _errorMessage = result.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Błąd rejestracji: {ex.Message}";
        }
        finally
        {
            _isWorking = false;
        }
    }

    private void TogglePassword()
    {
        _passwordType = _passwordType == "password" ? "text" : "password";
        _passwordIcon = _passwordType == "password" ? "👁️" : "🙈";
    }

    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "Nazwa użytkownika jest wymagana")]
        [StringLength(100, MinimumLength = 3, ErrorMessage = "Nazwa użytkownika musi mieć 3–100 znaków")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Hasło jest wymagane")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Hasło musi mieć co najmniej 8 znaków")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Potwierdzenie hasła jest wymagane")]
        [Compare(nameof(Password), ErrorMessage = "Hasła nie są identyczne")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [Range(typeof(bool), "true", "true", ErrorMessage = "Musisz zaakceptować regulamin")]
        public bool AcceptsTerms { get; set; }
    }
}
