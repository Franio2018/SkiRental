@* SkiRental.UI.Shared/Components/Booking/BookingWizard.razor *@
@using SkiRental.Domain.Enums
@using SkiRental.Domain.Models
@using SkiRental.Logic
@using SkiRental.Logic.Interfaces
@using SkiRental.Logic.Services
@using SkiRental.Logic.Options
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IDisposable

@inject IRecommendationOrchestrator RecommendationOrchestrator
@inject BookingService BookingService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IAuthenticationService AuthService
@inject UserService UserService
@inject IOptions<SkiRentalOptions> SkiOpts
@inject RentalRulesService Rules

<div class="booking-wizard">

    @* ── Custom Popup Modal (JavaScript-based) ─────────────────────────────── *@
    <div id="custom-popup" class="popup-overlay popup-hidden" onclick="hidePopup();">
        <div class="popup-content" onclick="event.stopPropagation();">
            <div class="popup-header">
                <h3 id="popup-title">Tytuł</h3>
                <button class="popup-close" onclick="hidePopup();">×</button>
            </div>
            <div class="popup-body">
                <p id="popup-message">Wiadomość</p>
            </div>
            <div class="popup-footer">
                <button class="btn-primary" onclick="hidePopup();">OK</button>
            </div>
        </div>
    </div>

    @* ── Pasek postępu ──────────────────────────────────────────────────── *@
    <div class="wizard-progress">
        @for (int i = 1; i <= 3; i++)
        {
            var step = i;
            <div class="step @(CurrentStep == step ? "active" : "") @(CurrentStep > step ? "done" : "")">
                <div class="step-circle">@(CurrentStep > step ? "✓" : step.ToString())</div>
                <span class="step-label">@StepLabels[step - 1]</span>
            </div>
            @if (step < 3)
            {
                <div class="step-connector"></div>
            }
        }
    </div>

    @* ── KROK 1: Profil ─────────────────────────────────────────────────── *@
    @if (CurrentStep == 1)
    {
        <div class="wizard-step step-profile">
            <h2>🎿 Twój profil narciarski</h2>
            <p class="step-description">Inteligentny Asystent dobierze sprzęt idealnie do Twoich parametrów.</p>

            <div class="form-grid">
                <div class="form-group">
                    <label>Wzrost (cm)</label>
                    <input type="number"
                           @bind-value="ProfileHeight"
                           @bind-value:event="oninput"
                           min="100" max="250"
                           class="form-input" />
                </div>
                <div class="form-group">
                    <label>Waga (kg)</label>
                    <input type="number"
                           @bind-value="ProfileWeight"
                           @bind-value:event="oninput"
                           step="0.5" min="30" max="300"
                           class="form-input" />
                </div>
                <div class="form-group">
                    <label>Rozmiar buta (EU)</label>
                    <input type="number"
                           @bind-value="ShoeSize"
                           @bind-value:event="oninput"
                           min="30" max="55"
                           class="form-input" />
                </div>
            </div>

            <div class="style-selector">
                <h3>Styl jazdy</h3>
                <div class="style-cards">
                    <button class="style-card @(SelectedStyle == SkiStyle.Classic ? "selected" : "")"
                            id="style-classic"
                            type="button"
                            onclick="wizardBridge.setStyle(0)">
                        <div class="style-icon" style="pointer-events:none">🎿</div>
                        <h4 style="pointer-events:none">Klasyczny</h4>
                        <p style="pointer-events:none">Narty w śladach, rytmiczny krok. Idealny dla spokojnych tras.</p>
                    </button>

                    <button class="style-card @(SelectedStyle == SkiStyle.Skate ? "selected" : "")"
                            id="style-skate"
                            type="button"
                            onclick="wizardBridge.setStyle(1)">
                        <div class="style-icon" style="pointer-events:none">⛷️</div>
                        <h4 style="pointer-events:none">Łyżwowy (Skate)</h4>
                        <p style="pointer-events:none">Dynamiczny ślizg na twardym śniegu. Wyższe wymagania techniczne.</p>
                    </button>
                </div>
            </div>

            <div class="skill-selector">
                <h3>Poziom zaawansowania</h3>
                <div class="skill-pills">
                    @foreach (SkillLevel level in Enum.GetValues<SkillLevel>())
                    {
                        var lvl = level;
                        <button class="skill-pill @(SelectedSkill == lvl ? "active" : "")"
                                type="button"
                                onclick="@($"wizardBridge.setSkill({(int)lvl})")">
                            @SkillLabels[lvl]
                        </button>
                    }
                </div>
            </div>

            <button class="btn-primary"
                    type="button"
                    onclick="wizardBridge.goToStep2()"
                    disabled="@(!IsStep1Valid)">
                Dalej oblicz rekomendacje →
            </button>
        </div>
    }

    @* ── KROK 2: Rekomendacja ────────────────────────────────────────────── *@
    @if (CurrentStep == 2)
    {
        <div class="wizard-step step-recommendation">
            <h2>🤖 Rekomendacja Inteligentnego Asystenta</h2>

            @if (_isCalculating)
            {
                <div class="loading-spinner">
                    <div class="spinner"></div>
                    <p>Obliczam optymalny sprzęt…</p>
                </div>
            }
            else if (_recommendationError is not null)
            {
                <div class="error-notice no-match-notice">
                    <h3>@_noMatchTitle</h3>
                    <p>@_recommendationError</p>
                    @if (_noMatchReasons.Any())
                    {
                        <ul class="no-match-list">
                            @foreach (var r in _noMatchReasons)
                            {
                                <li><strong>@RecommendationUserMessages.CategoryNamePl(r.Category):</strong> @r.ConstraintDescription</li>
                            }
                        </ul>
                    }
                </div>
                <div class="wizard-nav">
                    <button class="btn-secondary" type="button" onclick="wizardBridge.goToStep1()">← Wróć do profilu</button>
                </div>
            }
            else if (_orchestratorResult is not null)
            {
                @if (!string.IsNullOrEmpty(_partialWarning))
                {
                    <div class="warning-banner">
                        <span>⚠️</span>
                        <p>@_partialWarning</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_orchestratorResult.AlgorithmExplanation))
                {
                    <pre class="algorithm-snippet">@_orchestratorResult.AlgorithmExplanation</pre>
                }

                <h3>Twój pakiet (@RecommendationUserMessages.FormatRequiredPackage())</h3>
                @foreach (var cat in RentalEquipmentCategories.All)
                {
                    if (!_orchestratorResult.Selection.TryGetValue(cat, out var eq)) continue;
                    var eqId = eq.Id;
                    var matchStatus = _orchestratorResult.MatchStatus.GetValueOrDefault(cat);
                    var fallback = _orchestratorResult.FallbackNotes.GetValueOrDefault(cat);
                    <div class="equipment-card selected">
                        <div class="eq-header">
                            <span class="eq-category">@CategoryLabel(cat)</span>
                            <span class="match-pill @matchStatus.ToString().ToLower()">@MatchLabel(matchStatus)</span>
                        </div>
                        <h4>@eq.Brand @eq.Model</h4>
                        <div class="eq-details">
                            <span>@eq.Size @SizeUnit(cat)</span>
                            @if (eq.Stiffness.HasValue) { <span>Flex @eq.Stiffness</span> }
                            <span>@eq.DailyRate PLN/doba</span>
                        </div>
                        @if (!string.IsNullOrEmpty(fallback))
                        {
                            <p class="fallback-hint">@fallback</p>
                        }
                    </div>
                }

                <div class="wizard-nav">
                    <button class="btn-secondary" type="button" onclick="wizardBridge.goToStep1()">← Wróć</button>
                    <button class="btn-primary"
                            type="button"
                            onclick="wizardBridge.goToStep3()"
                            disabled="@(!HasFullPackage)">
                        Dalej – Płatność →
                    </button>
                </div>
            }
        </div>
    }

    @* ── KROK 3: Płatność ────────────────────────────────────────────────── *@
    @if (CurrentStep == 3)
    {
        <div class="wizard-step step-payment">
            <h2>💳 Termin i płatność</h2>
            <p class="step-description">@RecommendationUserMessages.SpotPaymentHint</p>

            <div class="form-grid">
                <div class="form-group">
                    <label>Data rozpoczęcia</label>
                    <input type="date" class="form-input" @bind="_startDate" min="@_minDate" max="@_maxDate" />
                </div>
                <div class="form-group">
                    <label>Data zakończenia</label>
                    <input type="date" class="form-input" @bind="_endDate" min="@_minDate" max="@_maxDate" />
                </div>
            </div>
            <p class="rental-season-hint">
                Sezon wypożyczeń: @SeasonStartText – @SeasonEndText (max @SkiOpts.Value.MaxRentalDaysPerBooking dni).
            </p>

            <div class="price-summary">
                <h3>Podsumowanie</h3>
                <div class="price-lines">
                    @if (_orchestratorResult is not null)
                    {
                        @foreach (var kvp in _orchestratorResult.Selection)
                        {
                            var eq = kvp.Value;
                            <div class="price-line">
                                <span>@eq.Brand @eq.Model (@eq.Size @SizeUnit(kvp.Key))</span>
                                <span>@eq.DailyRate PLN/d</span>
                            </div>
                        }
                    }
                    <div class="price-total">
                        <strong>Łącznie (szacunek)</strong>
                        <strong>@EstimatedTotal PLN</strong>
                    </div>
                </div>
            </div>

            <h3>Sposób płatności</h3>
            <div class="payment-method-row">
                <button type="button"
                        class="method-chip @(_paymentMethod == PaymentMethod.Spot ? "active" : "")"
                        onclick="wizardBridge.setPaymentMethod(0)">
                    💵 W lokalu (na miejscu)
                </button>
                <button type="button"
                        class="method-chip @(_paymentMethod == PaymentMethod.Online ? "active" : "")"
                        onclick="wizardBridge.setPaymentMethod(1)">
                    💳 Online (BLIK)
                </button>
            </div>

            @if (_paymentMethod == PaymentMethod.Online)
            {
                <div class="blik-section">
                    <label>Kod BLIK (6 cyfr)</label>
                    <input type="text" @bind="BlikCode" maxlength="6" class="blik-input" placeholder="------" />
                </div>
            }
            else
            {
                <div class="spot-info-box">
                    Płatność przy odbiorze w wypożyczalni. Rezerwacja zostanie zapisana bez obciążenia konta online.
                </div>
            }

            @if (_bookingError is not null)
            {
                <div class="error-notice">❌ @_bookingError</div>
            }

            <div class="wizard-nav">
                <button class="btn-secondary" type="button" onclick="wizardBridge.backToStep2()">← Wróć</button>
                <button class="btn-primary btn-pay"
                        type="button"
                        onclick="wizardBridge.confirmBooking()"
                        disabled="@(_isProcessing || !CanConfirmPayment)">
                    @GetConfirmButtonText()
                </button>
            </div>
        </div>
    }

    @* ── SUKCES ───────────────────────────────────────────────────────────── *@
    @if (CurrentStep == 4 && _bookingResult is not null)
    {
        <div class="wizard-step step-success text-center">
            <div class="success-icon" style="font-size: 3rem;">🎉</div>
            <h2>Rezerwacja potwierdzona!</h2>
            <p>Twój kod QR do odbioru sprzętu@( _paymentMethod == PaymentMethod.Spot ? " — płatność w lokalu przy odbiorze" : ""):</p>
            <div class="qr-placeholder" style="border: 2px dashed #ccc; padding: 2rem; margin: 1rem 0;">
                <div class="qr-code-display" style="font-weight: bold; font-size: 1.5rem;">@_bookingResult.QrCode</div>
                <p class="qr-hint">Pokaż ten kod pracownikowi przy odbiorze.</p>
            </div>
            <button class="btn-primary" type="button" onclick="wizardBridge.goHome()">
                Wróć do strony głównej
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime? RentalStart { get; set; }
    [Parameter] public DateTime? RentalEnd { get; set; }

    // ── Authentication ───────────────────────────────────────────────────────
    private int _customerProfileId;
    private bool _profileLoaded;
    private string? _profileError;

    // ── JS Interop bridge (MAUI WebView @onclick workaround) ─────────────────
    private DotNetObjectReference<BookingWizard>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("wizardBridgeInit", _dotNetRef);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated || AuthService.CurrentUserId is null)
        {
            Navigation.NavigateTo("/login?returnUrl=/booking");
            return;
        }

        try
        {
            var profile = await UserService.GetProfileAsync(AuthService.CurrentUserId.Value);
            if (profile is null)
            {
                // Profil jeszcze nie wypełniony – przekieruj do edycji
                Navigation.NavigateTo("/profile?returnUrl=/booking");
                return;
            }

            _customerProfileId = profile.Id;
            _profileLoaded = true;

            // Wstępnie uzupełnij pola z profilu
            ProfileHeight = profile.Height;
            ProfileWeight = profile.Weight;
            ShoeSize = profile.ShoeSize;
            SelectedStyle = profile.PreferredStyle;
            SelectedSkill = profile.SkillLevel;

            ApplyRentalDates(RentalStart, RentalEnd);
        }
        catch (Exception ex)
        {
            _profileError = $"Błąd wczytania profilu: {ex.Message}";
        }
    }

    public void Dispose() => _dotNetRef?.Dispose();

    [JSInvokable]
    public async Task JsSetStyle(int val)
    {
        SelectedStyle = (SkiStyle)val;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task JsSetSkill(int val)
    {
        SelectedSkill = (SkillLevel)val;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task JsGoToStep2() => InvokeAsync(GoToStep2Async);

    // ────────────────────────────────────────────────────────────────────────
    private int CurrentStep = 1;
    private readonly string[] StepLabels = new[] { "Profil", "Sprzęt", "Płatność" };

    // ── Krok 1 Data ─────────────────────────────────────────────────────────
    private int ProfileHeight = 175;
    private decimal ProfileWeight = 75m;
    private int ShoeSize = 42;
    private SkiStyle SelectedStyle = SkiStyle.Classic;
    private SkillLevel SelectedSkill = SkillLevel.Intermediate;

    private bool IsStep1Valid =>
        ProfileHeight is >= 100 and <= 250 &&
        ProfileWeight is >= 30 and <= 300 &&
        ShoeSize is >= 30 and <= 55;

    private static readonly Dictionary<SkillLevel, string> SkillLabels = new()
    {
        [SkillLevel.Beginner] = "🟢 Początkujący",
        [SkillLevel.Intermediate] = "🔵 Średnio zaawansowany",
        [SkillLevel.Advanced] = "🟠 Zaawansowany",
        [SkillLevel.Expert] = "🔴 Ekspert"
    };

    // ── Krok 2 Data ─────────────────────────────────────────────────────────
    private RecommendationResult? _orchestratorResult;
    private bool _isCalculating;
    private string? _recommendationError;
    private string _noMatchTitle = "";
    private List<NoMatchReason> _noMatchReasons = [];
    private string? _partialWarning;

    // ── Krok 3 Data ─────────────────────────────────────────────────────────
    private DateTime _startDate = DateTime.Today;
    private DateTime _endDate = DateTime.Today.AddDays(RentalWindowHelper.DefaultSpanDays);
    private string _minDate = "";
    private string _maxDate = "";
    private string SeasonStartText => SkiOpts.Value.SeasonStart.ToString("dd.MM.yyyy");
    private string SeasonEndText => SkiOpts.Value.SeasonEnd.ToString("dd.MM.yyyy");
    private PaymentMethod _paymentMethod = PaymentMethod.Spot;
    private string BlikCode = string.Empty;
    private bool _isProcessing;
    private string? _bookingError;

    private bool HasFullPackage =>
        _orchestratorResult is not null
        && RecommendationUserMessages.RequiredPackage.All(c => _orchestratorResult.Selection.ContainsKey(c));

    private bool CanConfirmPayment =>
        _paymentMethod == PaymentMethod.Spot
        || (_paymentMethod == PaymentMethod.Online && BlikCode.Length == 6 && BlikCode.All(char.IsDigit));

    private decimal EstimatedTotal
    {
        get
        {
            if (_orchestratorResult is null) return 0;
            var (start, end) = GetBookingWindow();
            var days = (decimal)RentalWindowHelper.CountRentalDays(start, end);
            return Math.Round(_orchestratorResult.Selection.Values.Sum(e => e.DailyRate) * days, 2);
        }
    }

    private void ApplyRentalDates(DateTime? start, DateTime? end)
    {
        _minDate = SkiOpts.Value.SeasonStart.ToString("yyyy-MM-dd");
        _maxDate = SkiOpts.Value.SeasonEnd.ToString("yyyy-MM-dd");

        if (start.HasValue && end.HasValue)
        {
            _startDate = start.Value.Date;
            _endDate = end.Value.Date;
        }
        else
        {
            (_startDate, _endDate) = RentalWindowHelper.GetDefaultDates(SkiOpts.Value);
        }

        NormalizeEndDate();
    }

    private void NormalizeEndDate()
    {
        if (_endDate <= _startDate)
            _endDate = _startDate.AddDays(1);

        var maxByPolicy = _startDate.AddDays(SkiOpts.Value.MaxRentalDaysPerBooking);
        if (_endDate > maxByPolicy)
            _endDate = maxByPolicy;

        if (_endDate > SkiOpts.Value.SeasonEnd.Date)
            _endDate = SkiOpts.Value.SeasonEnd.Date;
    }

    private (DateTime Start, DateTime End) GetBookingWindow()
        => RentalWindowHelper.ToBookingWindow(_startDate, _endDate);

    // ── Krok 4 Data ─────────────────────────────────────────────────────────
    private BookingResult? _bookingResult;

    // ── Logic Methods ───────────────────────────────────────────────────────

    private void SetStyle(SkiStyle style)
    {
        SelectedStyle = style;
        StateHasChanged();
    }

    private void SetSkill(SkillLevel level)
    {
        SelectedSkill = level;
        StateHasChanged();
    }

    private async Task GoToStep2Async()
    {
        if (!IsStep1Valid) return;

        CurrentStep = 2;
        _isCalculating = true;
        _orchestratorResult = null;
        _recommendationError = null;
        _noMatchReasons = [];
        _partialWarning = null;
        StateHasChanged();

        try
        {
            var parameters = new EquipmentSelectionParameters
            {
                Height = ProfileHeight,
                Weight = ProfileWeight,
                ShoeSize = ShoeSize,
                Style = SelectedStyle,
                SkillLevel = SelectedSkill
            };

            var result = await RecommendationOrchestrator.RecommendAsync(parameters);

            if (result.Status == RecommendationStatus.NoMatch)
            {
                _noMatchReasons = result.NoMatchReasons;
                _noMatchTitle = RecommendationUserMessages.GetNoMatchTitle(_noMatchReasons);
                _recommendationError = RecommendationUserMessages.GetNoMatchLead(_noMatchReasons);
            }
            else
            {
                _orchestratorResult = result;
                _partialWarning = RecommendationUserMessages.GetPartialPackageWarning(result);
                if (string.IsNullOrEmpty(_partialWarning))
                    _partialWarning = null;
            }
        }
        catch (Exception ex)
        {
            _recommendationError = $"Nie udało się dobrać sprzętu: {ex.Message}";
        }
        finally
        {
            _isCalculating = false;
            StateHasChanged();
        }
    }

    private void GoToStep3() => CurrentStep = 3;

    [JSInvokable]
    public Task JsGoToStep1()
    {
        CurrentStep = 1;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task JsBackToStep2()
    {
        CurrentStep = 2;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task JsGoToStep3()
    {
        if (!HasFullPackage)
        {
            return InvokeAsync(async () =>
            {
                var msg = _noMatchReasons.Count > 0
                    ? RecommendationUserMessages.GetNoMatchLead(_noMatchReasons)
                    : "Najpierw dobierz pełny pakiet: narty, kijki i buty.";
                await JS.InvokeVoidAsync("showPopup", "Brak pełnego pakietu", msg);
                StateHasChanged();
            });
        }
        GoToStep3();
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task JsSetPaymentMethod(int method)
    {
        _paymentMethod = (PaymentMethod)method;
        _bookingError = null;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task JsConfirmBooking() => InvokeAsync(ConfirmBookingAsync);

    [JSInvokable]
    public Task JsGoHome() => InvokeAsync(() =>
    {
        Navigation.NavigateTo("/");
        return Task.CompletedTask;
    });

    private static string CategoryLabel(EquipmentCategory c) => c switch
    {
        EquipmentCategory.Skis => "⛷️ Narty",
        EquipmentCategory.Poles => "🎿 Kijki",
        EquipmentCategory.Boots => "👢 Buty",
        _ => c.ToString()
    };

    private static string SizeUnit(EquipmentCategory c) => c switch
    {
        EquipmentCategory.Boots => "EU",
        _ => "cm"
    };

    private string GetConfirmButtonText()
    {
        if (_isProcessing) return "Przetwarzam…";
        return _paymentMethod == PaymentMethod.Spot
            ? $"Potwierdź rezerwację • {EstimatedTotal:F2} PLN (płatność w lokalu)"
            : $"Zapłać {EstimatedTotal:F2} PLN BLIK";
    }

    private static string MatchLabel(MatchStatus status) => status switch
    {
        MatchStatus.ExactMatch => "Idealne",
        MatchStatus.FallbackMatch => "Zastępcze",
        _ => "—"
    };

    private async Task ConfirmBookingAsync()
    {
        if (_orchestratorResult is null || !HasFullPackage)
        {
            _bookingError = "Nie można potwierdzić rezerwacji — brakuje nart, kijków lub butów w magazynie.";
            StateHasChanged();
            return;
        }

        NormalizeEndDate();
        var (startTime, endTime) = GetBookingWindow();
        var windowCheck = Rules.ValidateBookingWindow(startTime, endTime);
        if (!windowCheck.IsValid)
        {
            _bookingError = windowCheck.Error;
            StateHasChanged();
            return;
        }

        _isProcessing = true;
        _bookingError = null;
        StateHasChanged();

        var request = new CreateBookingRequest
        {
            CustomerProfileId = _customerProfileId,
            EquipmentIds = _orchestratorResult.Selection.Values.Select(e => e.Id).ToList(),
            StartTime = startTime,
            EndTime = endTime,
            BlikCode = _paymentMethod == PaymentMethod.Online ? BlikCode : null,
        };

        _bookingResult = await BookingService.CreateBookingAsync(request);

        if (_bookingResult.IsSuccess)
            CurrentStep = 4;
        else
            _bookingError = _bookingResult.ErrorMessage;

        _isProcessing = false;
        StateHasChanged();
    }
}