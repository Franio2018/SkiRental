@* SkiRental.UI.Shared/Components/Booking/BookingWizard.razor *@
@using SkiRental.Domain.Enums
@using SkiRental.Domain.Models
@using SkiRental.Logic.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop

@inject EquipmentMathService EquipmentMath
@inject BookingService BookingService
@inject NavigationManager Navigation

<div class="booking-wizard">

    @* ── Hidden Fields for State Management ─────────────────────────────────── *@
    <input type="hidden" id="selected-style" value="@((int)SelectedStyle)" />
    <input type="hidden" id="selected-skill" value="@((int)SelectedSkill)" />

    @* ── Custom Popup Modal (JavaScript-based) ─────────────────────────────── *@
    <div id="custom-popup" class="popup-overlay" style="display: none;" onclick="hidePopup();">
        <div class="popup-content" onclick="event.stopPropagation();">
            <div class="popup-header">
                <h3 id="popup-title">Tytuł</h3>
                <button class="popup-close" onclick="hidePopup();">×</button>
            </div>
            <div class="popup-body">
                <p id="popup-message">Wiadomość</p>
            </div>
            <div class="popup-footer">
                <button class="btn-primary" onclick="hidePopup();">OK</button>
            </div>
        </div>
    </div>

    @* ── Pasek postępu ──────────────────────────────────────────────────── *@
    <div class="wizard-progress">
        @for (int i = 1; i <= 3; i++)
        {
            var step = i;
            <div class="step @(CurrentStep == step ? "active" : "") @(CurrentStep > step ? "done" : "")">
                <div class="step-circle">@(CurrentStep > step ? "✓" : step.ToString())</div>
                <span class="step-label">@StepLabels[step - 1]</span>
            </div>
            @if (step < 3)
            {
                <div class="step-connector"></div>
            }
        }
    </div>

    @* ── KROK 1: Profil ─────────────────────────────────────────────────── *@
    @if (CurrentStep == 1)
    {
        <div class="wizard-step step-profile">
            <h2>🎿 Twój profil narciarski</h2>
            <p class="step-description">Inteligentny Asystent dobierze sprzęt idealnie do Twoich parametrów.</p>

            <div class="form-grid">
                <div class="form-group">
                    <label>Wzrost (cm)</label>
                    <input type="number"
                           @bind-value="ProfileHeight"
                           @bind-value:event="oninput"
                           min="100" max="250"
                           class="form-input" />
                </div>
                <div class="form-group">
                    <label>Waga (kg)</label>
                    <input type="number"
                           @bind-value="ProfileWeight"
                           @bind-value:event="oninput"
                           step="0.5" min="30" max="300"
                           class="form-input" />
                </div>
                <div class="form-group">
                    <label>Rozmiar buta (EU)</label>
                    <input type="number"
                           @bind-value="ShoeSize"
                           @bind-value:event="oninput"
                           min="30" max="55"
                           class="form-input" />
                </div>
            </div>

            <div class="style-selector">
                <h3>Styl jazdy</h3>
                <div class="style-cards">
                    <button class="style-card @(SelectedStyle == SkiStyle.Classic ? "selected" : "")"
                            id="style-classic"
                            type="button"
                            onclick="selectStyle('classic', 'Wybrano styl: Klasyczny 🎿');">
                        <div class="style-icon" style="pointer-events:none">🎿</div>
                        <h4 style="pointer-events:none">Klasyczny</h4>
                        <p style="pointer-events:none">Narty w śladach, rytmiczny krok. Idealny dla spokojnych tras.</p>
                    </button>

                    <button class="style-card @(SelectedStyle == SkiStyle.Skate ? "selected" : "")"
                            id="style-skate"
                            type="button"
                            onclick="selectStyle('skate', 'Wybrano styl: Łyżwowy (Skate) ⛷️');">
                        <div class="style-icon" style="pointer-events:none">⛷️</div>
                        <h4 style="pointer-events:none">Łyżwowy (Skate)</h4>
                        <p style="pointer-events:none">Dynamiczny ślizg na twardym śniegu. Wyższe wymagania techniczne.</p>
                    </button>
                </div>
            </div>

            <div class="skill-selector">
                <h3>Poziom zaawansowania</h3>
                <div class="skill-pills">
                    @foreach (SkillLevel level in Enum.GetValues<SkillLevel>())
                    {
                        var lvl = level;
                        <button class="skill-pill @(SelectedSkill == lvl ? "active" : "")"
                                id="skill-@((int)lvl)"
                                type="button"
                                onclick="@($"selectSkill({(int)lvl}, 'Wybrano poziom: {SkillLabels[lvl]}');")">
                            @SkillLabels[lvl]
                        </button>
                    }
                </div>
            </div>

            @* Debugging HUD *@
            <div class="debug-panel" style="background:#f8f9fa; border:1px solid #ddd; padding:1rem; margin:1rem 0; border-radius:8px; font-family:monospace; font-size:11px;">
                <strong>DEBUG:</strong> Valid: @IsStep1Valid | H:@ProfileHeight W:@ProfileWeight S:@ShoeSize | Style:@SelectedStyle
            </div>

            <button class="btn-primary"
                    type="button"
                    onclick="showPopup('Przejście do kroku 2', 'Przechodzisz do kroku 2: Rekomendacja sprzętu');"
                    @onclick="GoToStep2"
                    disabled="@(!IsStep1Valid)">
                Dalej – Oblicz rekomendację →
            </button>
        </div>
    }

    @* ── KROK 2: Rekomendacja ────────────────────────────────────────────── *@
    @if (CurrentStep == 2)
    {
        <div class="wizard-step step-recommendation">
            <h2>🤖 Rekomendacja Inteligentnego Asystenta</h2>

            @if (_isCalculating)
            {
                <div class="loading-spinner">
                    <div class="spinner"></div>
                    <p>Obliczam optymalny sprzęt…</p>
                </div>
            }
            else if (_recommendation is not null)
            {
                <div class="recommendation-card">
                    <div class="rec-grid">
                        <div class="rec-item">
                            <span class="rec-label">Długość nart</span>
                            <span class="rec-value">@_recommendation.RecommendedSkiLength cm</span>
                        </div>
                        <div class="rec-item">
                            <span class="rec-label">Długość kijków</span>
                            <span class="rec-value">@_recommendation.RecommendedPoleLength cm</span>
                        </div>
                        <div class="rec-item">
                            <span class="rec-label">Sztywność Flex</span>
                            <span class="rec-value">@_recommendation.RecommendedStiffness</span>
                        </div>
                        <div class="rec-item">
                            <span class="rec-label">Rozmiar buta</span>
                            <span class="rec-value">EU @_recommendation.RecommendedBootSize</span>
                        </div>
                    </div>
                </div>

                <h3>Dostępny sprzęt</h3>
                @if (!_recommendation.MatchingEquipment.Any())
                {
                    <div class="no-equipment-notice">
                        ⚠️ Brak dostępnego sprzętu w tym rozmiarze.
                    </div>
                }
                else
                {
                    <div class="equipment-list">
                        @foreach (var eq in _recommendation.MatchingEquipment)
                        {
                            var eqId = eq.Id;
                            <div class="equipment-card @(SelectedEquipmentIds.Contains(eq.Id) ? "selected" : "")"
                                 @onclick="() => ToggleEquipment(eqId)">
                                <div class="eq-header">
                                    <span class="eq-category">@eq.Category</span>
                                    @if (SelectedEquipmentIds.Contains(eq.Id))
                                    {
                                        <span class="eq-selected-badge">✓ Wybrano</span>
                                    }
                                </div>
                                <h4>@eq.Brand @eq.Model</h4>
                                <div class="eq-details">
                                    <span>@eq.Size cm</span>
                                    @if (eq.Stiffness.HasValue)
                                    {
                                        <span>Flex @eq.Stiffness</span>
                                    }
                                    <span>@eq.DailyRate PLN/doba</span>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="wizard-nav">
                    <button class="btn-secondary" type="button" @onclick="() => CurrentStep = 1">← Wróć</button>
                    <button class="btn-primary"
                            type="button"
                            @onclick="GoToStep3"
                            disabled="@(!SelectedEquipmentIds.Any())">
                        Dalej – Płatność →
                    </button>
                </div>
            }
        </div>
    }

    @* ── KROK 3: Płatność ────────────────────────────────────────────────── *@
    @if (CurrentStep == 3)
    {
        <div class="wizard-step step-payment">
            <h2>💳 Termin i płatność BLIK</h2>

            <div class="form-grid">
                <div class="form-group">
                    <label>Od kiedy</label>
                    <input type="datetime-local" @bind="StartTime" class="form-input" />
                </div>
                <div class="form-group">
                    <label>Do kiedy</label>
                    <input type="datetime-local" @bind="EndTime" class="form-input" />
                </div>
            </div>

            <div class="price-summary">
                <h3>Podsumowanie</h3>
                <div class="price-lines">
                    @foreach (var id in SelectedEquipmentIds)
                    {
                        var eq = _recommendation?.MatchingEquipment.FirstOrDefault(e => e.Id == id);
                        if (eq is not null)
                        {
                            <div class="price-line">
                                <span>@eq.Brand @eq.Model (@eq.Size cm)</span>
                                <span>@eq.DailyRate PLN/d</span>
                            </div>
                        }
                    }
                    <div class="price-total">
                        <strong>Łącznie</strong>
                        <strong>@EstimatedTotal PLN</strong>
                    </div>
                </div>
            </div>

            <div class="blik-section">
                <label>Kod BLIK (6 cyfr)</label>
                <input type="text" @bind="BlikCode" maxlength="6" class="blik-input" placeholder="------" />
            </div>

            @if (_bookingError is not null)
            {
                <div class="error-notice">❌ @_bookingError</div>
            }

            <div class="wizard-nav">
                <button class="btn-secondary" type="button" @onclick="() => CurrentStep = 2">← Wróć</button>
                <button class="btn-primary btn-pay"
                        type="button"
                        @onclick="ConfirmBookingAsync"
                        disabled="@(_isProcessing || string.IsNullOrWhiteSpace(BlikCode))">
                    @(_isProcessing ? "Przetwarzam…" : $"Zapłać {EstimatedTotal} PLN BLIK")
                </button>
            </div>
        </div>
    }

    @* ── SUKCES ───────────────────────────────────────────────────────────── *@
    @if (CurrentStep == 4 && _bookingResult is not null)
    {
        <div class="wizard-step step-success text-center">
            <div class="success-icon" style="font-size: 3rem;">🎉</div>
            <h2>Rezerwacja potwierdzona!</h2>
            <p>Twój kod QR do odbioru sprzętu:</p>
            <div class="qr-placeholder" style="border: 2px dashed #ccc; padding: 2rem; margin: 1rem 0;">
                <div class="qr-code-display" style="font-weight: bold; font-size: 1.5rem;">@_bookingResult.QrCode</div>
                <p class="qr-hint">Pokaż ten kod pracownikowi przy odbiorze.</p>
            </div>
            <button class="btn-primary" type="button" @onclick='() => Navigation.NavigateTo("/")'>
                Wróć do strony głównej
            </button>
        </div>
    }
</div>

@code {
    private int CurrentStep = 1;
    private readonly string[] StepLabels = new[] { "Profil", "Sprzęt", "Płatność" };

    // ── Krok 1 Data ─────────────────────────────────────────────────────────
    private int ProfileHeight = 175;
    private decimal ProfileWeight = 75m;
    private int ShoeSize = 42;
    private SkiStyle SelectedStyle = SkiStyle.Classic;
    private SkillLevel SelectedSkill = SkillLevel.Intermediate;

    private bool IsStep1Valid =>
        ProfileHeight is >= 100 and <= 250 &&
        ProfileWeight is >= 30 and <= 300 &&
        ShoeSize is >= 30 and <= 55;

    private static readonly Dictionary<SkillLevel, string> SkillLabels = new()
    {
        [SkillLevel.Beginner] = "🟢 Początkujący",
        [SkillLevel.Intermediate] = "🔵 Średnio zaawansowany",
        [SkillLevel.Advanced] = "🟠 Zaawansowany",
        [SkillLevel.Expert] = "🔴 Ekspert"
    };

    // ── Krok 2 Data ─────────────────────────────────────────────────────────
    private EquipmentRecommendation? _recommendation;
    private bool _isCalculating;
    private readonly HashSet<int> SelectedEquipmentIds = new();

    // ── Krok 3 Data ─────────────────────────────────────────────────────────
    private DateTime StartTime = DateTime.Now.AddHours(1);
    private DateTime EndTime = DateTime.Now.AddDays(1);
    private string BlikCode = string.Empty;
    private bool _isProcessing;
    private string? _bookingError;

    private decimal EstimatedTotal => _recommendation?.MatchingEquipment
        .Where(e => SelectedEquipmentIds.Contains(e.Id))
        .Sum(e => e.DailyRate * (decimal)Math.Max(1, (EndTime - StartTime).TotalDays)) ?? 0;

    // ── Krok 4 Data ─────────────────────────────────────────────────────────
    private BookingResult? _bookingResult;

    // ── Logic Methods ───────────────────────────────────────────────────────

    private void SetStyle(SkiStyle style)
    {
        SelectedStyle = style;
        StateHasChanged();
    }

    private void SetSkill(SkillLevel level)
    {
        SelectedSkill = level;
        StateHasChanged();
    }

    private async Task GoToStep2()
    {
        CurrentStep = 2;
        _isCalculating = true;
        StateHasChanged();

        var parameters = new EquipmentSelectionParameters
        {
            Height = ProfileHeight,
            Weight = ProfileWeight,
            ShoeSize = ShoeSize,
            Style = SelectedStyle,
            SkillLevel = SelectedSkill
        };

        try
        {
            _recommendation = await EquipmentMath.RecommendAsync(parameters);
        }
        catch (Exception ex)
        {
            _bookingError = $"Błąd: {ex.Message}";
            CurrentStep = 1;
        }
        finally
        {
            _isCalculating = false;
            StateHasChanged();
        }
    }

    private void GoToStep3() => CurrentStep = 3;

    private void ToggleEquipment(int id)
    {
        if (!SelectedEquipmentIds.Remove(id))
            SelectedEquipmentIds.Add(id);

        StateHasChanged();
    }

    private async Task ConfirmBookingAsync()
    {
        _isProcessing = true;
        _bookingError = null;
        StateHasChanged();

        var request = new CreateBookingRequest
        {
            CustomerProfileId = 1, // Placeholder
            EquipmentIds = SelectedEquipmentIds.ToList(),
            StartTime = StartTime,
            EndTime = EndTime,
            BlikCode = BlikCode
        };

        _bookingResult = await BookingService.CreateBookingAsync(request);

        if (_bookingResult.IsSuccess)
            CurrentStep = 4;
        else
            _bookingError = _bookingResult.ErrorMessage;

        _isProcessing = false;
        StateHasChanged();
    }
}

@* JavaScript Functions for Popup Control and State Management *@
<script>
    function showPopup(title, message) {
        document.getElementById('popup-title').innerText = title;
        document.getElementById('popup-message').innerText = message;
        document.getElementById('custom-popup').style.display = 'flex';
    }

    function hidePopup() {
        document.getElementById('custom-popup').style.display = 'none';
    }

    function selectStyle(style, message) {
        // Remove selected class from all style cards
        document.querySelectorAll('.style-card').forEach(card => {
            card.classList.remove('selected');
        });
        
        // Add selected class to clicked style card
        const styleElement = document.getElementById('style-' + style);
        if (styleElement) {
            styleElement.classList.add('selected');
        }
        
        // Update hidden field
        const styleValue = style === 'classic' ? 0 : 1;
        document.getElementById('selected-style').value = styleValue;
        
        // Update debug panel
        updateDebugPanel();
        
        // Show popup
        showPopup('Styl jazdy', message);
    }

    function selectSkill(skillLevel, message) {
        // Remove active class from all skill pills
        document.querySelectorAll('.skill-pill').forEach(pill => {
            pill.classList.remove('active');
        });
        
        // Add active class to clicked skill pill
        const skillElement = document.getElementById('skill-' + skillLevel);
        if (skillElement) {
            skillElement.classList.add('active');
        }
        
        // Update hidden field
        document.getElementById('selected-skill').value = skillLevel;
        
        // Update debug panel
        updateDebugPanel();
        
        // Show popup
        showPopup('Poziom zaawansowania', message);
    }

    function updateDebugPanel() {
        const styleValue = document.getElementById('selected-style').value;
        const skillValue = document.getElementById('selected-skill').value;
        
        const styleText = styleValue === '0' ? 'Classic' : 'Skate';
        const skillText = skillValue === '0' ? 'Beginner' : 
                         skillValue === '1' ? 'Intermediate' : 
                         skillValue === '2' ? 'Advanced' : 'Expert';
        
        // Try to update debug panel if it exists
        const debugPanel = document.querySelector('.debug-panel');
        if (debugPanel) {
            const currentText = debugPanel.innerHTML;
            const styleMatch = currentText.match(/Style:\w+/);
            const skillMatch = currentText.match(/Skill:\w+/);
            
            if (styleMatch) {
                debugPanel.innerHTML = currentText.replace(styleMatch[0], 'Style:' + styleText);
            }
            if (skillMatch) {
                debugPanel.innerHTML = currentText.replace(skillMatch[0], 'Skill:' + skillText);
            }
        }
    }
</script>