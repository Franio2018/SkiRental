@* SkiRental.UI.Shared/Components/Employee/QrScannerPanel.razor *@
@using SkiRental.Domain.Models
@using SkiRental.Domain.Enums
@using SkiRental.Logic.Services
@using SkiRental.Logic.Interfaces
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web

@inject BookingService BookingService
@inject IAuthenticationService Auth
@inject IJSRuntime JS

<div class="qr-scanner-panel">
    <div class="panel-header">
        <h2>📷 Panel Pracownika – Skaner QR / NFC</h2>
        <div class="scan-mode-toggle">
            <button class="mode-btn @(ScanMode == "return"  ? "active" : "")" @onclick='() => SetMode("return")'>
                🔄 Zwrot sprzętu
            </button>
            <button class="mode-btn @(ScanMode == "pickup"  ? "active" : "")" @onclick='() => SetMode("pickup")'>
                📦 Wydanie sprzętu
            </button>
        </div>
    </div>

    @* ── Scanner viewport ── *@
    <div class="scanner-viewport">
        @if (!_scannerActive)
        {
            <button class="btn-start-scan" @onclick="ActivateScannerAsync">
                <span class="scan-icon">📷</span>
                Kliknij aby włączyć kamerę
            </button>
        }
        else
        {
            <div id="zxing-native-placeholder" data-active="true" class="scanner-live">
                <div class="scan-crosshair">
                    <div class="crosshair-corner tl"></div>
                    <div class="crosshair-corner tr"></div>
                    <div class="crosshair-corner bl"></div>
                    <div class="crosshair-corner br"></div>
                </div>
                <p class="scan-hint">Skieruj kamerę na kod QR na opasce klienta</p>
            </div>
        }
    </div>

    @* ── Manual code entry ── *@
    <div class="manual-input-section">
        <label>lub wpisz kod ręcznie</label>
        <div class="manual-row">
            <input type="text" @bind="ManualQrCode" @bind:event="oninput"
                   placeholder="SKI-XXXXXX-…" class="manual-input"
                   @onkeydown="HandleEnterKey" />
            <button class="btn-verify" @onclick="ProcessQrCodeAsync" disabled="@_isProcessing">
                @(_isProcessing ? "Sprawdzam…" : "Weryfikuj")
            </button>
        </div>
    </div>

    @* ── Rental info card ── *@
    @if (_rentalInfo is not null && _rentalError is null)
    {
        <div class="rental-info-card success">
            <h3>✅ Wypożyczenie potwierdzone</h3>
            <div class="rental-details">
                <div class="detail-row">
                    <span>Klient:</span>
                    <strong>@_rentalInfo.Customer?.FirstName @_rentalInfo.Customer?.LastName</strong>
                </div>
                <div class="detail-row">
                    <span>Termin:</span>
                    <strong>@_rentalInfo.StartTime.ToString("dd.MM HH:mm") – @_rentalInfo.EndTime.ToString("dd.MM HH:mm")</strong>
                </div>
                <div class="detail-row">
                    <span>Status:</span>
                    <strong>@_rentalInfo.Status</strong>
                </div>
                <div class="detail-row">
                    <span>Kwota:</span>
                    <strong>@_rentalInfo.TotalAmount.ToString("N2") zł</strong>
                </div>
            </div>

            @* ── Sprzęt lista ── *@
            <div class="equipment-list">
                <h4>Sprzęt (@_rentalInfo.RentalEquipments.Count szt.)</h4>
                @foreach (var re in _rentalInfo.RentalEquipments)
                {
                    <div class="equipment-item">
                        <span>@re.Equipment.Brand @re.Equipment.Model (@re.Equipment.SerialNumber)</span>

                        @* Condition picker — shown only in return mode *@
                        @if (ScanMode == "return")
                        {
                            <div class="condition-picker">
                                <span class="condition-label">Stan (1–5):</span>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var score = i;
                                    <button class="condition-btn @(_conditions.GetValueOrDefault(re.EquipmentId) == score ? "selected" : "")"
                                            @onclick="() => _conditions[re.EquipmentId] = score">
                                        @score
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── Action buttons ── *@
            <div class="rental-actions">
                @if (ScanMode == "pickup" && _rentalInfo.Status == RentalStatus.Pending)
                {
                    <button class="btn-primary" @onclick="ActivateRentalAsync" disabled="@_isProcessing">
                        📦 Wydaj sprzęt (Aktywuj)
                    </button>
                }
                else if (ScanMode == "return" && _rentalInfo.Status == RentalStatus.Active)
                {
                    <button class="btn-primary" @onclick="ProcessReturnAsync" disabled="@_isProcessing">
                        🔄 Zatwierdź zwrot
                    </button>
                }
                else
                {
                    <p class="status-note">
                        Wypożyczenie ma status <strong>@_rentalInfo.Status</strong>. Brak dostępnych akcji.
                    </p>
                }
            </div>
        </div>
    }

    @* ── Error card ── *@
    @if (_rentalError is not null)
    {
        <div class="rental-info-card error">
            <h3>❌ Błąd</h3>
            <p>@_rentalError</p>
            <button class="btn-secondary" @onclick="Reset">Spróbuj ponownie</button>
        </div>
    }

    @* ── Damage surcharge alert ── *@
    @if (_damageAlert is not null)
    {
        <div class="damage-alert">
            <h3>⚠️ Sprzęt uszkodzony</h3>
            <p>@_damageAlert</p>
            <p class="damage-note">Skontaktuj się z Właścicielem w celu naliczenia dopłaty za uszkodzenia.</p>
            <button class="btn-primary" @onclick="Reset">Zamknij</button>
        </div>
    }

    @* ── Success banner ── *@
    @if (_successMessage is not null)
    {
        <div class="success-banner">
            ✅ @_successMessage
        </div>
    }
</div>

@code {
    private string ScanMode  = "return";
    private string ManualQrCode = string.Empty;
    private bool _scannerActive;
    private bool _isProcessing;

    private Rental?       _rentalInfo;
    private string?       _rentalError;
    private string?       _successMessage;
    private string?       _damageAlert;

    // equipmentId → condition score (1–5) for return flow
    private Dictionary<int, int> _conditions = new();

    private void SetMode(string mode)
    {
        ScanMode = mode;
        Reset();
    }

    private void Reset()
    {
        _rentalInfo     = null;
        _rentalError    = null;
        _successMessage = null;
        _damageAlert    = null;
        _conditions     = new();
        ManualQrCode    = string.Empty;
    }

    private async Task HandleEnterKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ProcessQrCodeAsync();
        }
    }

    private async Task ActivateScannerAsync()
    {
        _scannerActive = true;
        // ZXing native scanner is activated via MAUI bridge (QrNfcBridgeService)
        // The bridge calls JS interop which triggers OnQrCodeScanned below.
        await JS.InvokeVoidAsync("skiRental.activateScanner");
    }

    [JSInvokable("OnQrCodeScanned")]
    public async Task OnQrCodeScanned(string qrCode)
    {
        ManualQrCode = qrCode;
        await ProcessQrCodeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ProcessQrCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(ManualQrCode)) return;

        _isProcessing   = true;
        _rentalInfo     = null;
        _rentalError    = null;
        _successMessage = null;
        _conditions     = new();

        try
        {
            // Look up rental by QR code using the repository via BookingService
            // NOTE: BookingService.GetByQrCode is a thin wrapper we call here
            // directly via EF — in production this would go through an API endpoint.
            var rental = await BookingService.GetRentalByQrCodeAsync(ManualQrCode);

            if (rental is null)
                _rentalError = $"Nie znaleziono wypożyczenia dla kodu: {ManualQrCode}";
            else
            {
                _rentalInfo = rental;
                // Pre-fill conditions at 5 (perfect) for return mode
                foreach (var re in rental.RentalEquipments)
                    _conditions[re.EquipmentId] = 5;
            }
        }
        catch (Exception ex)
        {
            _rentalError = $"Błąd: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task ActivateRentalAsync()
    {
        if (_rentalInfo is null) return;
        _isProcessing = true;

        try
        {
            var result = await BookingService.ActivateRentalAsync(
                _rentalInfo.Id, Auth.CurrentUserId ?? 0);

            if (result.IsSuccess)
            {
                _successMessage = $"Sprzęt wydany. Wypożyczenie #{_rentalInfo.Id} aktywne.";
                _rentalInfo     = null;
            }
            else
            {
                _rentalError = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _rentalError = $"Błąd aktywacji: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task ProcessReturnAsync()
    {
        if (_rentalInfo is null) return;
        _isProcessing = true;

        try
        {
            var result = await BookingService.ProcessReturnByQrCodeAsync(
                ManualQrCode, _conditions);

            if (result.IsSuccess)
            {
                _successMessage = $"Zwrot zarejestrowany o {result.ReturnTime?.ToString("HH:mm")}.";

                if (result.DamagedEquipmentIds.Any())
                {
                    var ids = string.Join(", ", result.DamagedEquipmentIds);
                    _damageAlert = $"Sprzęt o ID [{ids}] zwrócony w stanie poniżej 3/5. " +
                                   "Sprawdź uszkodzenia i nalicz dopłatę.";
                }

                _rentalInfo = null;
            }
            else
            {
                _rentalError = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            _rentalError = $"Błąd zwrotu: {ex.Message}";
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
